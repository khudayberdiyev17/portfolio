
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "admin-panel": {
      "root": "admin-panel",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/portfolio/v1/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/media/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/khudayberdiyev_admin/(.*)",
      "destination": {
        "service": "admin-panel"
      }
    },
    {
      "source": "/khudayberdiyev_admin",
      "destination": {
        "service": "admin-panel"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
