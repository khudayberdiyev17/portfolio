# ══════════════════════════════════════════════════════
#  Portfolio — .env.example
#  Nusxa oling: cp .env.example .env
#  Keyin SECRET_KEY ni o'zgartiring!
# ══════════════════════════════════════════════════════

# Frontend + Admin panel porti
APP_PORT=4000

# JWT uchun yashirin kalit — ALBATTA O'ZGARTIRING!
# Generatsiya: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32

# Token muddati
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fayl yuklash limiti (MB)
MAX_FILE_SIZE_MB=5
